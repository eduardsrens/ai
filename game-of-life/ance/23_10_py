import re


def apvienot_intervalus(intervali):
    sakartoti = sorted(
        (min(sakums, beigas), max(sakums, beigas))
        for sakums, beigas in intervali
    )
    rezultats = []

    for sakums, beigas in sakartoti:
        if rezultats and sakums <= rezultats[-1][1]:
            rezultats[-1][1] = max(rezultats[-1][1], beigas)
        else:
            rezultats.append([sakums, beigas])

    return rezultats


def nolasit_intervalus(vertiba):
    vertiba = vertiba.strip()
    if vertiba == "[]":
        return []

    atrastie = list(re.finditer(r"\[\s*(-?\d+)\s*,\s*(-?\d+)\s*\]", vertiba))
    if not atrastie:
        raise ValueError("intervals must be in the format [start, end] or [].")

    atlikums = re.sub(r"\[\s*-?\d+\s*,\s*-?\d+\s*\]", "", vertiba)
    if re.fullmatch(r"[\s,;]*", atlikums) is None:
        raise ValueError("the interval list contains invalid text or format.")

    intervali = []
    for intervls in atrastie:
        sakums, beigas = int(intervls.group(1)), int(intervls.group(2))
        if sakums > beigas:
            sakums, beigas = beigas, sakums
        intervali.append([sakums, beigas])
    return intervali


def formatet_intervalus(intervali):
    return " ".join(f"[{sakums}, {beigas}]" for sakums, beigas in intervali) or "[]"


def apstradat_testu_tabulu(galvene, tabula):
    rezultats = [galvene]
    for rindas_numurs, rinda in enumerate(tabula[1:], start=2):
        if len(rinda) != len(galvene):
            raise ValueError(
                f"row {rindas_numurs} of the table has {len(rinda)} columns, "
                f"but the header has {len(galvene)}."
            )
        if not rinda[0].strip():
            raise ValueError(f"row {rindas_numurs} is missing the test name.")

        apstradata_rinda = [rinda[0].strip()]
        for kolonnas_numurs, vertiba in enumerate(rinda[1:], start=2):
            try:
                intervali = nolasit_intervalus(vertiba)
            except ValueError as kluda:
                raise ValueError(
                    f"in column '{galvene[kolonnas_numurs - 1]}' of row {rindas_numurs}: {kluda}"
                ) from kluda
            apstradata_rinda.append(
                formatet_intervalus(apvienot_intervalus(intervali))
            )
        rezultats.append(apstradata_rinda)

    return rezultats


def apstradat_intervalu_tabulu(tabula):
    sakuma_virsraksti = {"start", "begin", "sākums", "sakums"}
    beigu_virsraksti = {"end", "finish", "beigas", "beigu"}
    ir_virsraksts = (
        len(tabula[0]) == 2
        and tabula[0][0].strip().lower() in sakuma_virsraksti
        and tabula[0][1].strip().lower() in beigu_virsraksti
    )
    datu_rindas = tabula[1:] if ir_virsraksts else tabula
    intervali = []

    if not datu_rindas:
        raise ValueError("the table contains no intervals.")

    sakuma_rindas_numurs = 2 if ir_virsraksts else 1
    for rindas_numurs, rinda in enumerate(
        datu_rindas,
        start=sakuma_rindas_numurs,
    ):
        if len(rinda) != 2:
            raise ValueError(
                f"row {rindas_numurs} must contain exactly two columns."
            )
        try:
            sakums, beigas = (int(vienums.strip()) for vienums in rinda)
        except ValueError as kluda:
            raise ValueError(
                f"row {rindas_numurs} requires integer start and end values."
            ) from kluda
        intervali.append([sakums, beigas])

    apvienotie = apvienot_intervalus(intervali)
    return [["Start", "End"]] + [
        [str(sakums), str(beigas)] for sakums, beigas in apvienotie
    ]


def apstradat_tabulu(rindas):
    tabula = [rinda.rstrip("\r\n").split("\t") for rinda in rindas]
    if not tabula or len(tabula[0]) < 2:
        raise ValueError("paste a table with at least two columns.")

    tabula = [[kolonna.strip() for kolonna in rinda] for rinda in tabula]
    if tabula[0][0].lower().startswith("nr"):
        if len(tabula) < 2:
            raise ValueError("paste a header and at least one data row.")
        galvene = tabula[0]
        return apstradat_testu_tabulu(galvene, tabula)
    return apstradat_intervalu_tabulu(tabula)


def main():
    print("Paste a table from Excel or Google Sheets.")
    print("For test tables, use interval values in cells, for example: [1, 4] [5, 9].")
    print("For an empty interval list, use [].")
    print("You can also paste a two-column table called 'Start' and 'End'.")
    print("When all rows are pasted, press Enter on a blank line.\n")

    rindas = []
    while True:
        rinda = input()
        if not rinda.strip():
            break
        rindas.append(rinda)

    if not rindas:
        print("No table was entered.")
        return

    try:
        rezultats = apstradat_tabulu(rindas)
    except ValueError as kluda:
        print(f"Error: {kluda}")
        return

    print("\nMerged intervals:")
    for rinda in rezultats:
        print("\t".join(rinda))


if __name__ == "__main__":
    main()
